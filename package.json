{
  "name": "financeiro-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:teste:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:teste:down": "docker compose -f docker-compose.test.yml down",
    "db:teste:preparar": "node scripts/teste/com-env-teste.mjs node_modules/jiti/lib/jiti-cli.mjs scripts/teste/preparar-banco.ts",
    "dev:teste": "node scripts/teste/com-env-teste.mjs node_modules/next/dist/bin/next dev -p 3100",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.17.0",
    "next": "^16.3.5",
    "next-auth": "^5.0.0-beta.31",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "prisma": "^7.10.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
