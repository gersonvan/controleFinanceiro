generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lancamento {
  id            Int       @id @default(autoincrement())
  data          DateTime
  descricao     String
  categoria     String?
  valor         Float
  tipo          String
  conta         String
  status        String    @default("Paga")
  fonte         String?
  mesReferencia DateTime?
  pessoa        String?
  userId        String    @default("")
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([data])
  @@index([categoria])
  @@index([conta])
  @@index([tipo])
  @@index([userId, data])
  @@index([userId, mesReferencia])
  @@index([userId, categoria])
  @@index([userId, pessoa])
}

// Perfil do usuário — criado no primeiro login, controla onboarding e nome exibido.
model UserProfile {
  userId             String   @id
  nome               String   @default("")
  onboardingCompleto Boolean  @default(false)
  createdAt          DateTime @default(now())
}

model MemoriaIA {
  id               Int      @id @default(autoincrement())
  descricao        String
  categoriaCorreta String
  userId           String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([descricao, userId])
}

// Perfil de importação configurável pelo usuário.
// - builtin != null  -> usa um dos parsers legados (parsers.ts), compatibilidade
// - builtin == null  -> usa o motor genérico (lib/importacao/engine.ts)
model PerfilImportacao {
  id            Int      @id @default(autoincrement())
  userId        String
  nome          String   // ex: "C6 Crédito", "Itaú Extrato"
  conta         String   // nome da conta atribuído aos lançamentos
  formato       String   @default("csv") // "csv" | "ofx"

  // CSV: configuração de leitura
  delimitador   String   @default(",")   // "," ";" "\t"
  linhasPular   Int      @default(0)      // linhas de cabeçalho a ignorar
  formatoData   String   @default("DD/MM/AAAA") // DD/MM/AAAA | AAAA-MM-DD | DD-MM-AAAA | MM/DD/AAAA

  // CSV: mapeamento de colunas (índice baseado em 0)
  modoValor     String   @default("unica") // "unica" | "separadas"
  colData       Int?
  colDescricao  Int?
  colValor      Int?     // modoValor = "unica"
  colEntrada    Int?     // modoValor = "separadas"
  colSaida      Int?     // modoValor = "separadas"
  inverterSinal Boolean  @default(false)  // faturas de cartão: positivo = saída

  // Mês de referência: faturas pedem ao usuário no upload; extratos usam a data
  usaMesReferencia Boolean @default(false)

  // Compatibilidade com parsers legados (null para perfis genéricos)
  builtin       String?

  // Visibilidade na tela de importação (usuário ativa/desativa em Configurações)
  ativo         Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}
