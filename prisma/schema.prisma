generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lancamento {
  id            Int       @id @default(autoincrement())
  data          DateTime
  descricao     String
  categoria     String?
  valor         Float
  tipo          String
  conta         String
  status        String    @default("Paga")
  fonte         String?
  mesReferencia DateTime?
  pessoa        String?
  userId        String    @default("")
  createdAt     DateTime  @default(now())
  /// Soma dos reembolsos vinculados a este gasto (positivo). Mantido por src/lib/reembolso-dados.ts
  valorReembolsado Float  @default(0)
  reembolsosRecebidos Reembolso[] @relation("GastoReembolsado")
  reembolsosFeitos    Reembolso[] @relation("PixDeReembolso")
  /// Importação de arquivo que criou o lançamento (para desfazer); null = manual ou anterior a 10/2026
  importacaoId  Int?
  importacao    Importacao? @relation(fields: [importacaoId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([data])
  @@index([categoria])
  @@index([conta])
  @@index([tipo])
  @@index([userId, data])
  @@index([userId, mesReferencia])
  @@index([userId, categoria])
  @@index([userId, pessoa])
  @@index([importacaoId])
}

// Perfil do usuário — criado no primeiro login, controla onboarding e nome exibido.
model UserProfile {
  userId             String   @id
  nome               String   @default("")
  nomeCompleto       String   @default("") // como aparece nos extratos: reconhece Pix entre contas próprias
  onboardingCompleto Boolean  @default(false)
  createdAt          DateTime @default(now())

  // Fotografia do mês
  margemPercentual      Float     @default(20) // reserva sobre as entradas
  fotografiaConcluidaEm DateTime?               // null = dashboard lembra de fazer

  // Previsão: categorias que o usuário marcou como encerradas (valem zero)
  previsaoEncerradas String[] @default([])
}

// Item da Fotografia do mês: o que o usuário planeja receber/gastar.
model PlanejamentoItem {
  id            Int      @id @default(autoincrement())
  userId        String
  grupo         String   // "entrada" | "fixo" | "variavel" | "sazonal" | "parcela"
  descricao     String
  categoria     String   // sempre uma de CATEGORIAS
  valor         Float    // positivo; unidade definida por periodicidade
  periodicidade String   @default("mensal") // "mensal" | "semanal" | "anual"
  parcelaAtual  Int?     // só grupo "parcela"
  parcelaTotal  Int?
  ordem         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, grupo])
}

model MemoriaIA {
  id               Int      @id @default(autoincrement())
  descricao        String
  categoriaCorreta String
  userId           String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([descricao, userId])
}

// Perfil de importação configurável pelo usuário.
// - builtin != null  -> usa um dos parsers legados (parsers.ts), compatibilidade
// - builtin == null  -> usa o motor genérico (lib/importacao/engine.ts)
model PerfilImportacao {
  id            Int      @id @default(autoincrement())
  userId        String
  nome          String   // ex: "C6 Crédito", "Itaú Extrato"
  conta         String   // nome da conta atribuído aos lançamentos
  formato       String   @default("csv") // "csv" | "ofx"

  // CSV: configuração de leitura
  delimitador   String   @default(",")   // "," ";" "\t"
  linhasPular   Int      @default(0)      // linhas de cabeçalho a ignorar
  formatoData   String   @default("DD/MM/AAAA") // DD/MM/AAAA | AAAA-MM-DD | DD-MM-AAAA | MM/DD/AAAA

  // CSV: mapeamento de colunas (índice baseado em 0)
  modoValor     String   @default("unica") // "unica" | "separadas"
  colData       Int?
  colDescricao  Int?
  colParcela    Int?
  colValor      Int?     // modoValor = "unica"
  colEntrada    Int?     // modoValor = "separadas"
  colSaida      Int?     // modoValor = "separadas"
  inverterSinal Boolean  @default(false)  // faturas de cartão: positivo = saída
  // Descrição completa: coluna que complementa a descrição (ex.: "Detalhes") e
  // linhas sem data logo abaixo do lançamento que trazem o resto dela
  colComplemento      Int?
  juntarLinhasSemData Boolean @default(false)

  // Mês de referência: faturas pedem ao usuário no upload; extratos usam a data
  usaMesReferencia Boolean @default(false)

  // Compatibilidade com parsers legados (null para perfis genéricos)
  builtin       String?

  // Visibilidade na tela de importação (usuário ativa/desativa em Configurações)
  banco         String?  // perfis nativos: derivado da chave; personalizados: escolhido pelo usuário
  tipoConta     String?  // "corrente" | "cartao" — a conta é banco + tipo (lib/bancos.ts)
  ativo         Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  // Um perfil nativo por usuário; perfis personalizados (builtin null) não colidem.
  @@unique([userId, builtin])
}

// Tipo de cada conta (nome como aparece em Lancamento.conta): separa gastos
// no cartão de crédito dos gastos pela conta corrente. Criada sob demanda a
// partir das contas dos lançamentos, com o tipo sugerido pelo nome.
model Conta {
  id        Int      @id @default(autoincrement())
  userId    String
  nome      String   // gerado por lib/bancos.ts nomeDaConta (ex.: "Nubank · Crédito"); é o que os lançamentos guardam
  banco     String   @default("outro") // id de BANCOS em lib/bancos.ts
  apelido   String   @default("")      // distingue duas contas do mesmo banco e tipo; nome livre do banco "outro"
  tipo      String   @default("corrente") // "corrente" (Débito) | "cartao" (Crédito)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, nome])
  @@unique([userId, banco, tipo, apelido]) // uma conta por banco + Débito/Crédito + apelido
}

/// "Dividir": um Pix recebido (entrada, categoria Reembolso) abate um ou mais gastos.
model Reembolso {
  id        Int        @id @default(autoincrement())
  userId    String
  entradaId Int
  saidaId   Int
  valor     Float      // parte do Pix atribuída a este gasto (positivo)
  createdAt DateTime   @default(now())
  entrada   Lancamento @relation("PixDeReembolso", fields: [entradaId], references: [id], onDelete: Cascade)
  saida     Lancamento @relation("GastoReembolsado", fields: [saidaId], references: [id], onDelete: Cascade)

  @@unique([entradaId, saidaId])
  @@index([userId, saidaId])
}

/// Onde o dinheiro guardado está (CDB, RDB, previdência…): saldo informado numa
/// data; depois dela, aplicações e resgates dos extratos atualizam a estimativa.
model Reserva {
  id              Int      @id @default(autoincrement())
  userId          String
  nome            String
  tipo            String   @default("investimento") // "investimento" | "previdencia" | "conta"
  bloqueada       Boolean  @default(false)           // ex.: previdência até a portabilidade
  saldoInformado  Float
  dataSaldo       DateTime
  conta           String?  // conta dos lançamentos que movimentam esta reserva (ex.: "Sofisa")
  filtroDescricao String?  // opcional: só lançamentos cuja descrição contém isto (ex.: "RDB")
  observacao      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
}

/// "Mesmo pagamento": descrições diferentes do mesmo compromisso sob um nome
/// comum (ex.: AYMORE e SANTANDER no financiamento do carro). chave =
/// chaveMemoria(descrição); Matriz, Revisar e o histórico agrupam por nome.
model Apelido {
  id        Int      @id @default(autoincrement())
  userId    String
  chave     String
  nome      String
  createdAt DateTime @default(now())

  @@unique([userId, chave])
  @@index([userId])
}

/// Desafio aceito (src/lib/desafios.ts): um modelo do catálogo com a meta, o
/// período e o normal do usuário no aceite; resultado e economia quando fecha.
model Desafio {
  id          Int       @id @default(autoincrement())
  userId      String
  modelo      String    // "zero-encargos" | "sobra" | "teto-categoria" | "semana-sem-delivery"
  categoria   String?   // alvo dos desafios de gasto
  meta        Float     // gasto/encargos: máximo; sobra: mínimo
  referencia  Float     // média dos 6 meses anteriores, no tamanho do período
  inicio      DateTime
  fim         DateTime
  status      String    @default("ativo") // "ativo" | "cumprido" | "nao_cumprido" | "abandonado"
  resultado   Float?
  economia    Float?    // referência − resultado (≥ 0); null na sobra
  parcial     Boolean   @default(false)   // fechado sem todos os extratos do período
  encerradoEm DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, status])
}

/// Uma importação de arquivo: agrupa os lançamentos que ela criou, para o
/// usuário poder desfazer (src/lib/importacoes.ts).
model Importacao {
  id          Int          @id @default(autoincrement())
  userId      String
  perfil      String       // nome do perfil usado
  conta       String
  arquivo     String
  saldo       Json?        // saldo da conta que ela gravou na Reserva: { reservaId, anterior: {saldo, data} | null, gravado: {saldo, data} }
  createdAt   DateTime     @default(now())
  lancamentos Lancamento[]

  @@index([userId, createdAt])
}

/// Finanças compartilhadas (src/lib/espaco.ts): o dono (donoUserId) deixa outra
/// pessoa (membroEmail) ver ou ajudar. Quem foi convidado alterna entre as
/// próprias finanças e as do dono; a permissão é conferida a cada requisição.
model Acesso {
  id          Int      @id @default(autoincrement())
  donoUserId  String
  membroEmail String
  papel       String   // "ver" | "ajudar"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([donoUserId, membroEmail])
  @@index([membroEmail])
}

/// Categorias do usuário (src/lib/categorias-usuario.ts), por dono das finanças:
/// as nativas que ele ocultou (com o destino do que cairia nelas) e as
/// personalizadas que criou. As nativas do sistema (CATEGORIAS_DO_SISTEMA, que o
/// app usa nos cálculos) nunca aparecem aqui.
model CategoriaUsuario {
  id        Int      @id @default(autoincrement())
  userId    String
  nome      String
  nativa    Boolean  // true = nativa oculta; false = personalizada
  grupo     String?  // personalizada: o grupo onde aparece (define entrada ou saída)
  destino   String?  // nativa oculta: para onde vão regras e IA (null = sem categoria)
  fatia     String?  // personalizada de gasto: "necessidades" | "desejos" | "futuro" (lib/fatias.ts; null = a do grupo)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, nome])
}

/// Plano da família (src/lib/familia.ts): pessoas da casa, renda de cada uma e as
/// contas fixas com quem paga, num plano principal e em cenários. Não pertence às
/// finanças de ninguém: quem participa está em MembroPlano (quem criou convida e
/// remove). `dados` é validado por dadosFamiliaSchema a cada gravação e `versao`
/// detecta edição simultânea (o app junta as alterações de linhas diferentes).
model PlanoFamilia {
  id            Int           @id @default(autoincrement())
  nome          String
  criadoPor     String        // e-mail (minúsculo) de quem criou
  dados         Json
  versao        Int           @default(0)
  atualizadoPor String?       // e-mail de quem salvou por último
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  membros       MembroPlano[]

  @@index([criadoPor])
}

/// Quem participa de um plano da família: convidado (aceito = false) até aceitar.
/// `pessoa` liga o membro a uma pessoa do plano (é para ela que vai o que ele traz
/// da própria Fotografia); `vistos` guarda o que da Fotografia dele já foi trazido
/// ou dispensado, para avisar só do que mudou (lib/familia.ts, assinaturaFotografia).
/// A renda e as contas pessoais (pagas por ele, para ele) são privadas até ele
/// mostrar: o servidor nem as envia aos outros (lib/familia.ts, semOcultos).
model MembroPlano {
  id           Int          @id @default(autoincrement())
  planoId      Int
  email        String       // minúsculo
  pessoa       String?
  aceito       Boolean      @default(false)
  convidadoPor String?
  vistos       Json?
  mostrarRenda    Boolean   @default(false)
  mostrarPessoais Boolean   @default(false)
  createdAt    DateTime     @default(now())
  plano        PlanoFamilia @relation(fields: [planoId], references: [id], onDelete: Cascade)

  @@unique([planoId, email])
  @@index([email])
}
