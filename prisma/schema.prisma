generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lancamento {
  id            Int       @id @default(autoincrement())
  data          DateTime
  descricao     String
  categoria     String?
  valor         Float
  tipo          String
  conta         String
  status        String    @default("Paga")
  fonte         String?
  mesReferencia DateTime?
  pessoa        String?
  userId        String    @default("")
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([data])
  @@index([categoria])
  @@index([conta])
  @@index([tipo])
}

model MemoriaIA {
  id               Int      @id @default(autoincrement())
  descricao        String
  categoriaCorreta String
  userId           String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([descricao, userId])
}
